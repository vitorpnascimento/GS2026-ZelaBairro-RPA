<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_P_ASIS" targetNamespace="http://zelabairro/rpa">
 <collaboration id="col_P_ASIS"><participant id="P_ASIS" name="ZelaBairro - Encaminhamento de ocorrências ao SP156 (AS-IS)" processRef="P_ASIS_proc"/></collaboration>
 <process id="P_ASIS_proc" isExecutable="false">
  <laneSet id="ls_P_ASIS">
   <lane id="L1" name="Operador do ZelaBairro">
    <flowNodeRef>S</flowNodeRef>
    <flowNodeRef>T1</flowNodeRef>
    <flowNodeRef>T2</flowNodeRef>
    <flowNodeRef>G1</flowNodeRef>
    <flowNodeRef>T3</flowNodeRef>
    <flowNodeRef>G2</flowNodeRef>
    <flowNodeRef>T4</flowNodeRef>
    <flowNodeRef>T5</flowNodeRef>
    <flowNodeRef>T6</flowNodeRef>
    <flowNodeRef>T7</flowNodeRef>
    <flowNodeRef>T8</flowNodeRef>
    <flowNodeRef>T9</flowNodeRef>
    <flowNodeRef>E1</flowNodeRef>
    <flowNodeRef>T10</flowNodeRef>
    <flowNodeRef>E2</flowNodeRef>
    <flowNodeRef>T11</flowNodeRef>
    <flowNodeRef>E3</flowNodeRef>
   </lane>
  </laneSet>
  <startEvent id="S" name="Ocorrência pendente">
   <outgoing>F1</outgoing>
  </startEvent>
  <task id="T1" name="Localizar a ocorrência na planilha exportada do painel">
   <incoming>F1</incoming>
   <outgoing>F2</outgoing>
  </task>
  <task id="T2" name="Conferir campos obrigatórios (local, categoria e descrição)">
   <incoming>F2</incoming>
   <outgoing>F3</outgoing>
  </task>
  <exclusiveGateway id="G1" name="Dados completos?">
   <incoming>F3</incoming>
   <outgoing>F4</outgoing>
   <outgoing>F13</outgoing>
  </exclusiveGateway>
  <task id="T3" name="Verificar se já existe ocorrência no mesmo local e categoria">
   <incoming>F4</incoming>
   <outgoing>F5</outgoing>
  </task>
  <exclusiveGateway id="G2" name="Ocorrência duplicada?">
   <incoming>F5</incoming>
   <outgoing>F6</outgoing>
   <outgoing>F15</outgoing>
  </exclusiveGateway>
  <task id="T4" name="Acessar o Portal SP156 e fazer login">
   <incoming>F6</incoming>
   <outgoing>F7</outgoing>
  </task>
  <task id="T5" name="Selecionar o serviço correspondente à categoria">
   <incoming>F7</incoming>
   <outgoing>F8</outgoing>
  </task>
  <task id="T6" name="Preencher endereço, descrição e anexar a foto">
   <incoming>F8</incoming>
   <outgoing>F9</outgoing>
  </task>
  <task id="T7" name="Enviar a solicitação">
   <incoming>F9</incoming>
   <outgoing>F10</outgoing>
  </task>
  <task id="T8" name="Copiar o número de protocolo">
   <incoming>F10</incoming>
   <outgoing>F11</outgoing>
  </task>
  <task id="T9" name="Registrar o protocolo e atualizar o status para &quot;encaminhada&quot;">
   <incoming>F11</incoming>
   <outgoing>F12</outgoing>
  </task>
  <endEvent id="E1" name="Ocorrência encaminhada">
   <incoming>F12</incoming>
  </endEvent>
  <task id="T10" name="Marcar a ocorrência como &quot;aguardando cidadão&quot;">
   <incoming>F13</incoming>
   <outgoing>F14</outgoing>
  </task>
  <endEvent id="E2" name="Ocorrência aguardando cidadão">
   <incoming>F14</incoming>
  </endEvent>
  <task id="T11" name="Marcar como &quot;duplicada&quot; com o protocolo existente">
   <incoming>F15</incoming>
   <outgoing>F16</outgoing>
  </task>
  <endEvent id="E3" name="Ocorrência duplicada">
   <incoming>F16</incoming>
  </endEvent>
  <sequenceFlow id="F1" name="" sourceRef="S" targetRef="T1"/>
  <sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2"/>
  <sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G1"/>
  <sequenceFlow id="F4" name="Sim" sourceRef="G1" targetRef="T3"/>
  <sequenceFlow id="F5" name="" sourceRef="T3" targetRef="G2"/>
  <sequenceFlow id="F6" name="Não" sourceRef="G2" targetRef="T4"/>
  <sequenceFlow id="F7" name="" sourceRef="T4" targetRef="T5"/>
  <sequenceFlow id="F8" name="" sourceRef="T5" targetRef="T6"/>
  <sequenceFlow id="F9" name="" sourceRef="T6" targetRef="T7"/>
  <sequenceFlow id="F10" name="" sourceRef="T7" targetRef="T8"/>
  <sequenceFlow id="F11" name="" sourceRef="T8" targetRef="T9"/>
  <sequenceFlow id="F12" name="" sourceRef="T9" targetRef="E1"/>
  <sequenceFlow id="F13" name="Não" sourceRef="G1" targetRef="T10"/>
  <sequenceFlow id="F14" name="" sourceRef="T10" targetRef="E2"/>
  <sequenceFlow id="F15" name="Sim" sourceRef="G2" targetRef="T11"/>
  <sequenceFlow id="F16" name="" sourceRef="T11" targetRef="E3"/>
 </process>
