<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="def_P_TOBE" targetNamespace="http://zelabairro/rpa">
 <collaboration id="col_P_TOBE"><participant id="P_TOBE" name="ZelaBairro - Encaminhamento de ocorrências ao SP156 (TO-BE)" processRef="P_TOBE_proc"/></collaboration>
 <process id="P_TOBE_proc" isExecutable="false">
  <laneSet id="ls_P_TOBE">
   <lane id="LR" name="Robô (UiPath)">
    <flowNodeRef>S</flowNodeRef>
    <flowNodeRef>R1</flowNodeRef>
    <flowNodeRef>R2</flowNodeRef>
    <flowNodeRef>G1</flowNodeRef>
    <flowNodeRef>R4</flowNodeRef>
    <flowNodeRef>G2</flowNodeRef>
    <flowNodeRef>R6</flowNodeRef>
    <flowNodeRef>R7</flowNodeRef>
    <flowNodeRef>R8</flowNodeRef>
    <flowNodeRef>R9</flowNodeRef>
    <flowNodeRef>E1</flowNodeRef>
    <flowNodeRef>R3</flowNodeRef>
    <flowNodeRef>R5</flowNodeRef>
    <flowNodeRef>E3</flowNodeRef>
   </lane>
   <lane id="LO" name="Operador do ZelaBairro">
    <flowNodeRef>O1</flowNodeRef>
    <flowNodeRef>E2</flowNodeRef>
   </lane>
  </laneSet>
  <startEvent id="S" name="Rotina agendada">
   <outgoing>F1</outgoing>
  </startEvent>
  <task id="R1" name="Ler a ocorrência na planilha de pendentes">
   <incoming>F1</incoming>
   <outgoing>F2</outgoing>
  </task>
  <task id="R2" name="Validar campos obrigatórios">
   <incoming>F2</incoming>
   <outgoing>F3</outgoing>
  </task>
  <exclusiveGateway id="G1" name="Dados completos?">
   <incoming>F3</incoming>
   <outgoing>F4</outgoing>
   <outgoing>F11</outgoing>
  </exclusiveGateway>
  <task id="R4" name="Verificar duplicidade (mesmo local e categoria)">
   <incoming>F4</incoming>
   <outgoing>F5</outgoing>
  </task>
  <exclusiveGateway id="G2" name="Ocorrência duplicada?">
   <incoming>F5</incoming>
   <outgoing>F6</outgoing>
   <outgoing>F14</outgoing>
  </exclusiveGateway>
  <task id="R6" name="Acessar o Portal SP156 e fazer login">
   <incoming>F6</incoming>
   <outgoing>F7</outgoing>
  </task>
  <task id="R7" name="Selecionar o serviço e preencher endereço, descrição e foto">
   <incoming>F7</incoming>
   <outgoing>F8</outgoing>
  </task>
  <task id="R8" name="Enviar e capturar o número de protocolo">
   <incoming>F8</incoming>
   <outgoing>F9</outgoing>
  </task>
  <task id="R9" name="Gravar rpa_protocolo e rpa_status &quot;encaminhada&quot; na planilha">
   <incoming>F9</incoming>
   <outgoing>F10</outgoing>
  </task>
  <endEvent id="E1" name="Ocorrência encaminhada">
   <incoming>F10</incoming>
  </endEvent>
  <task id="R3" name="Gravar rpa_status &quot;aguardando cidadão&quot;">
   <incoming>F11</incoming>
   <outgoing>F12</outgoing>
  </task>
  <task id="O1" name="Analisar a ocorrência e pedir complemento ao morador">
   <incoming>F12</incoming>
   <outgoing>F13</outgoing>
  </task>
  <endEvent id="E2" name="Ocorrência aguardando cidadão">
   <incoming>F13</incoming>
  </endEvent>
  <task id="R5" name="Gravar rpa_status &quot;duplicada&quot; com o protocolo existente">
   <incoming>F14</incoming>
   <outgoing>F15</outgoing>
  </task>
  <endEvent id="E3" name="Ocorrência duplicada">
   <incoming>F15</incoming>
  </endEvent>
  <sequenceFlow id="F1" name="" sourceRef="S" targetRef="R1"/>
  <sequenceFlow id="F2" name="" sourceRef="R1" targetRef="R2"/>
  <sequenceFlow id="F3" name="" sourceRef="R2" targetRef="G1"/>
  <sequenceFlow id="F4" name="Sim" sourceRef="G1" targetRef="R4"/>
  <sequenceFlow id="F5" name="" sourceRef="R4" targetRef="G2"/>
  <sequenceFlow id="F6" name="Não" sourceRef="G2" targetRef="R6"/>
  <sequenceFlow id="F7" name="" sourceRef="R6" targetRef="R7"/>
  <sequenceFlow id="F8" name="" sourceRef="R7" targetRef="R8"/>
  <sequenceFlow id="F9" name="" sourceRef="R8" targetRef="R9"/>
  <sequenceFlow id="F10" name="" sourceRef="R9" targetRef="E1"/>
  <sequenceFlow id="F11" name="Não" sourceRef="G1" targetRef="R3"/>
  <sequenceFlow id="F12" name="" sourceRef="R3" targetRef="O1"/>
  <sequenceFlow id="F13" name="" sourceRef="O1" targetRef="E2"/>
  <sequenceFlow id="F14" name="Sim" sourceRef="G2" targetRef="R5"/>
  <sequenceFlow id="F15" name="" sourceRef="R5" targetRef="E3"/>
 </process>
